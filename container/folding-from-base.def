Bootstrap: localimage
From: /scout/containers/base-gpu.2026-04-16.001.sif

# Build a folding production container from base-gpu.
# Adds OpenFold, ESMFold, predict-structure CLI, and the dev code.
#
# Build:
#   APPTAINER_TMPDIR=/scout/tmp apptainer build \
#     /scout/containers/folding_FROM_BASE.sif \
#     container/folding-from-base.def

%files
    /home/wilke/Development/PredictStructureApp/predict_structure /app/predict-structure/predict_structure
    /home/wilke/Development/PredictStructureApp/pyproject.toml /app/predict-structure/pyproject.toml
    /home/wilke/Development/PredictStructureApp/README.md /app/predict-structure/README.md
    /home/wilke/Development/PredictStructureApp/cwl /app/predict-structure/cwl
    /home/wilke/Development/PredictStructureApp/app_specs /app/predict-structure/app_specs
    /home/wilke/Development/PredictStructureApp/test_data /app/predict-structure/test_data

%post
    # --- OpenFold 3 ---
    if [ ! -d /opt/conda-openfold ]; then
        /opt/miniforge/bin/conda create -y -p /opt/conda-openfold python=3.11
        /opt/conda-openfold/bin/pip install --no-cache-dir openfold3
        /opt/miniforge/bin/conda clean -afy
    fi

    # --- ESMFold (HuggingFace transformers) ---
    if [ ! -d /opt/conda-esmfold ]; then
        /opt/miniforge/bin/conda create -y -p /opt/conda-esmfold python=3.11
        /opt/conda-esmfold/bin/pip install --no-cache-dir 'torch>=2.6' transformers accelerate biopython
        /opt/miniforge/bin/conda clean -afy
    fi

    # --- predict-structure CLI ---
    if [ ! -d /opt/conda-predict ]; then
        /opt/miniforge/bin/conda create -y -p /opt/conda-predict python=3.12
        /opt/miniforge/bin/conda clean -afy
    fi

    cd /app/predict-structure && /opt/conda-predict/bin/pip install --no-cache-dir ".[all]"
    ln -sf /opt/conda-predict/bin/predict-structure /usr/local/bin/predict-structure

    # Issue #13: protein_compare is invoked by App-PredictStructure.pl
    # run_report() via `python -m protein_compare characterize`, but it is a
    # standalone package — NOT a predict-structure pyproject dependency. Install
    # it into the same conda-predict env so it is co-available at runtime.
    # NOTE: BV-BRC org URL per issue #13; confirm canonical source (see PR).
    /opt/conda-predict/bin/pip install --no-cache-dir \
        "protein_compare @ git+https://github.com/BV-BRC/protein_structure_analysis.git"

    # Issue #13: system packages for DSSP + matplotlib/seaborn rendering used by
    # protein_compare, plus the CCD compound dictionary DSSP needs.
    apt-get update
    apt-get install -y --no-install-recommends \
        dssp libgl1 libglib2.0-0 libfontconfig1
    mkdir -p /var/cache/libcifpp
    curl -fsSL -o /var/cache/libcifpp/components.cif \
        https://files.wwpdb.org/pub/pdb/data/monomers/components.cif

    # Cache / data directories (runtime bind-mounts will overlay these)
    mkdir -p /input /output /databases /cache
    chmod 777 /cache

%environment
    export BOLTZ_CACHE=/local_databases/boltz
    export CHAI_DOWNLOADS_DIR=/local_databases/chai
    export HF_HOME=/local_databases/esmfold
    # /local_databases/cache is the world-writable dir the acceptance suite and
    # run_qa_case.py already use; /local_databases/torch does not exist on the
    # GPU hosts.
    export TORCH_HOME=/local_databases/cache
    # OPENFOLD_CACHE is the variable openfold3 actually reads
    # (entry_points/parameters.py, entry_points/validator.py).
    export OPENFOLD_CACHE=/local_databases/openfold
    # Read by pandera/_pandas_deprecated.py in the Chai env; suppresses its
    # import-time deprecation warning so Chai's stdout stays clean.
    export DISABLE_PANDERA_IMPORT_WARNING=True

    # Issue #38: Boltz ships PyTorch with CUDA 13 libs under each conda env's
    # nvidia/*/lib dir (e.g. nvidia/cu13/lib/libnvrtc-builtins.so.13.0). These
    # are not on LD_LIBRARY_PATH, so Boltz crashes in torch.det() (nvrtc JIT).
    # Auto-discover every conda env's bundled NVIDIA lib dir (robust to python
    # version) and prepend it to LD_LIBRARY_PATH.
    for d in /opt/conda-*/lib/python*/site-packages/nvidia/*/lib; do
        [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
    done

%labels
    version 0.2.0-from-base-gpu
    base base-gpu.2026-04-16.001.sif
    built 2026-04-20

%runscript
    exec predict-structure "$@"
